# Docker / PostgreSQL
POSTGRES_DB=easyprogramming
POSTGRES_USER=easyprogramming
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# NestJS
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1d
# For local IP testing: http://SERVER_IP
# For a domain: https://example.com
CORS_ORIGIN=http://localhost

# Frontend -> backend through Nginx
NEXT_PUBLIC_API_URL=/api

# Bootstrap for a brand-new empty database.
# Keep true only until the initial schema exists; later use migrations.
DB_SYNCHRONIZE=true
